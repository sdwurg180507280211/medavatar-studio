# Providers: mock | elevenlabs / heygen
TTS_PROVIDER=mock
AVATAR_PROVIDER=mock

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=

# Optional public URL for audio when using HeyGen audio_url mode.
PUBLIC_ASSET_BASE_URL=

# Optional: skip Remotion's Chrome Headless Shell download (blocked in some
# regions) by pointing at a locally installed Chrome.
# REMOTION_CHROME_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
