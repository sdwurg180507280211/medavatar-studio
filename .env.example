# Project config controls the defaults. Environment variables can override providers.
TTS_PROVIDER=mock
AVATAR_PROVIDER=mock
# Keep single as the safe default. Set chaptered explicitly for long videos.
AVATAR_STRATEGY=single

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=

# Optional binaries for media conversion.
# LIBREOFFICE_BIN=soffice
# PDFTOPPM_BIN=pdftoppm
# FFMPEG_BIN=ffmpeg

# Optional local Chrome for Remotion.
# REMOTION_CHROME_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
